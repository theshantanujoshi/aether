{
  "name": "aether-agent-suite",
  "version": "0.2.0",
  "description": "Local-first skill kit for reviewed activity memory and repository visualization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theshantanujoshi/aether.git"
  },
  "homepage": "https://github.com/theshantanujoshi/aether#readme",
  "bugs": "https://github.com/theshantanujoshi/aether/issues",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "aether-kit": "bin/aether-kit.cjs"
  },
  "files": [
    "bin/aether-kit.cjs",
    ".agents/skills/**",
    ".claude/agents/**",
    ".claude/skills/**",
    ".codex/agents/**",
    "scripts/render_repository_graph.py",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "aether",
    "skills",
    "codex",
    "claude",
    "personal-memory",
    "repository-visualization"
  ]
}
